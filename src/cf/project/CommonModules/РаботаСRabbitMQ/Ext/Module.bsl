Процедура ДесериализацияJSON(JSONСтрока)
 			
	НачалоJSON = СтрНайти(JSONСтрока, "{");
	
	Длина =  СтрДлина(JSONСтрока);
	
	Объект = Сред(JSONСтрока, 0 , НачалоJSON - 1); 
	
	ТипОбъекта = Тип(Объект);

	JSONСтрока = Сред(JSONСтрока, НачалоJSON, Длина); 
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONСтрока);
	ОбъектXDTO = СериализаторXDTO.ПрочитатьJSON(ЧтениеJSON, ТипОбъекта);   
	
	ОбъектXDTO.Записать();	

КонецПроцедуры

